generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String
  username     String
  password     String
  createdAt    DateTime
  updatedAt    DateTime
  campaign     Campaign[]
  character    Character[]
  userCampaign UserCampaign[]
}

model UserCampaign {
  id       String   @id @default(uuid())
  userId   String
  tableId  String
  isMaster Boolean
  user     User     @relation(fields: [userId], references: [id])
  campaign Campaign @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

model Campaign {
  id        String         @id @default(uuid())
  name      String
  system    Sytem          @default(OLDRAGON)
  createdAt DateTime
  updatedAt DateTime
  Character Character[]
  User      User           @relation(fields: [userId], references: [id])
  userId    String
  userTable UserCampaign[]
}

model Character {
  id                     String         @id @default(uuid())
  name                   String
  race                   Race
  class                  Class
  subclass               SUBCLASS
  alignment              Alignment      @default(NEUTRAL)
  level                  Int
  experience             Int
  lifePoints             Int
  armorClass             Int
  initiative             Int
  baseAttackC            Int
  baseAttackD            Int
  savingThrowC           Int
  savingThrowD           Int
  savingThrowS           Int
  initialMoviment        Int
  physycalCharacteristcs String         @db.VarChar(1000)
  personality            String         @db.VarChar(1000)
  history                String         @db.VarChar(1000)
  goldPieces             Int
  silverPieces           Int
  copperPieces           Int
  actualCharge           Int
  maximumCharge          Int
  player                 String
  campaignId             String?
  createdAt              DateTime
  updatedAt              DateTime
  Campaign               Campaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  User                   User           @relation(fields: [player], references: [id], onDelete: Cascade)
  Inventory              Inventory[]
  Grimoire               Grimoire[]
  Attack                 Attack[]
  Strength               Strength?
  Dexterity              Dexterity?
  Constituition          Constituition?
  Intelligence           Intelligence?
  Wisdom                 Wisdom?
  Charisma               Charisma?
}

model Strength {
  id          String    @id @default(uuid())
  value       Int
  adjustment  Int
  characterId String    @unique
  Character   Character @relation(fields: [characterId], references: [id])
}

model Dexterity {
  id           String    @id @default(uuid())
  value        Int
  adjustment   Int
  rogueTalents String
  characterId  String    @unique
  Character    Character @relation(fields: [characterId], references: [id])
}

model Constituition {
  id          String    @id @default(uuid())
  value       Int
  adjustment  Int
  resurection Int
  characterId String    @unique
  Character   Character @relation(fields: [characterId], references: [id])
}

model Intelligence {
  id                     String    @id @default(uuid())
  value                  Int
  aditionalLanguage      Int
  percentLearnMagic      Int
  aditionalsArcaneMagics String
  characterId            String    @unique
  Character              Character @relation(fields: [characterId], references: [id])
}

model Wisdom {
  id                     String    @id @default(uuid())
  value                  Int
  adjustment             Int
  aditionalsDivineMagics String
  characterId            String    @unique
  Character              Character @relation(fields: [characterId], references: [id])
}

model Charisma {
  id                        String    @id @default(uuid())
  value                     Int
  maxFollowers              Int
  adjustmentReactionPercent Int
  livingDeadAway            String
  characterId               String    @unique
  Character                 Character @relation(fields: [characterId], references: [id])
}

model Attack {
  id          String    @id @default(uuid())
  characterId String
  EquipmentId String
  Equipment   Equipment @relation(fields: [EquipmentId], references: [id], onDelete: Cascade)
  Character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Grimoire {
  id          String    @id @default(uuid())
  use         Int
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  magicId     String
  Magic       Magic     @relation(fields: [magicId], references: [id], onDelete: Cascade)
}

model Inventory {
  id          String    @id @default(uuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  equipmentId String
  Equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model Equipment {
  id            String        @id @default(uuid())
  name          String
  quantity      Int
  charge        Int
  price         Int
  coin          Coin
  type          EquipmentType
  isMagic       Boolean
  size          Size
  equipped      Boolean
  weaponType    WeaponType?
  damageType    DamageType?
  damage        String?
  damageBonus   Int?
  armorBonus    Int?
  attackBonusC  Int?
  attackBonusD  Int?
  range         Int?
  increasesLoad Int?
  description   String        @db.VarChar(1000)
  Attack        Attack[]
  Inventory     Inventory[]
}

model Magic {
  id             String     @id @default(uuid())
  name           String
  type           MagicType
  circle         Int
  range          String
  duration       String
  protectivePlay String?
  description    String     @db.VarChar(1000)
  Grimoire       Grimoire[]
}

enum Coin {
  COPPER
  SILVER
  GOLD
}

enum WeaponType {
  MELEE
  DISTANCE
}

enum DamageType {
  IMPACTFUL
  PIERCING
  CUTTING
}

enum EquipmentType {
  ARMOR
  WEAPON
  SHIELD
  GENERAL
  CONTAINERS
  MOUNTING
}

enum Sytem {
  OLDRAGON
  CUSTOM
}

enum Race {
  HUMAN
  DWARF
  ELF
  HALFELF
  HALFLING
  GNOME
}

enum Class {
  ROGUE
  WIZARD
  CLERIC
  FIGHTER
}

enum SUBCLASS {
  BARBARIAN
  PALADIN
  DWARFADVENTURER
  ARCHER
  DRUID
  ACADEMIC
  SHAMAN
  OUTLAWED
  RANGER
  BARD
  KILLER
  HALFLINGADVENTURER
  ILLUSIONIST
  NECROMANTE
  WITCHER
  ELFADVENTURER
}

enum Alignment {
  ORDERLY
  NEUTRAL
  CHAOTIC
}

enum MagicType {
  ARCANE
  DIVINE
}

enum Size {
  SM
  MD
  LG
}
