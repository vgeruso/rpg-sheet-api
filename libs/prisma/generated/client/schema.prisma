generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String
  username      String
  password      String
  createdAt     DateTime
  updatedAt     DateTime
  campaign      Campaign[]
  character     Character[]
  user_campaign UserCampaign[]
}

model UserCampaign {
  id       String   @id @default(uuid())
  userId   String
  tableId  String
  isMaster Boolean
  user     User     @relation(fields: [userId], references: [id])
  campaign Campaign @relation(fields: [tableId], references: [id], onDelete: Cascade)
}

model Campaign {
  id         String         @id @default(uuid())
  name       String
  system     Sytem          @default(OLDRAGON)
  createdAt  DateTime
  updatedAt  DateTime
  Character  Character[]
  User       User?          @relation(fields: [userId], references: [id])
  userId     String?
  user_table UserCampaign[]
}

model Character {
  id                     String        @id @default(uuid())
  name                   String
  race                   Race
  class                  Class
  subclass               SUBCLASS
  alignment              Alignment     @default(NEUTRAL)
  level                  Int
  experience             Int
  lifePoints             Int
  armorClass             Int
  initiative             Int
  baseAttackC            Int
  baseAttackD            Int
  savingThrowC           Int
  savingThrowD           Int
  savingThrowS           Int
  initialMoviment        Int
  physycalCharacteristcs String        @db.VarChar(1000)
  personality            String        @db.VarChar(1000)
  history                String        @db.VarChar(1000)
  goldPieces             Int
  silverPieces           Int
  copperPieces           Int
  actualCharge           Int
  maximumCharge          Int
  player                 String
  campaignId             String?
  strengthId             String        @unique
  dexterityId            String        @unique
  constituitionId        String        @unique
  intelligenceId         String        @unique
  wisdomId               String        @unique
  charismaId             String        @unique
  createdAt              DateTime
  updatedAt              DateTime
  strength               Strength      @relation(fields: [strengthId], references: [id], onDelete: Cascade)
  dexterity              Dexterity     @relation(fields: [dexterityId], references: [id], onDelete: Cascade)
  constituition          Constituition @relation(fields: [constituitionId], references: [id], onDelete: Cascade)
  intelligence           Intelligence  @relation(fields: [intelligenceId], references: [id], onDelete: Cascade)
  wisdom                 Wisdom        @relation(fields: [wisdomId], references: [id], onDelete: Cascade)
  charisma               Charisma      @relation(fields: [charismaId], references: [id], onDelete: Cascade)
  user                   User          @relation(fields: [player], references: [id], onDelete: Cascade)
  campaign               Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  Inventory              Inventory?
  Grimoire               Grimoire[]
  Attack                 Attack[]
}

model Strength {
  id         String     @id @default(uuid())
  value      Int
  adjustment Int
  Character  Character?
}

model Dexterity {
  id           String     @id @default(uuid())
  value        Int
  adjustment   Int
  rogueTalents String
  Character    Character?
}

model Constituition {
  id          String     @id @default(uuid())
  value       Int
  adjustment  Int
  resurection Int
  Character   Character?
}

model Intelligence {
  id                     String     @id @default(uuid())
  value                  Int
  aditionalLanguage      Int
  percentLearnMagic      Int
  aditionalsArcaneMagics String
  Character              Character?
}

model Wisdom {
  id                     String     @id @default(uuid())
  value                  Int
  adjustment             Int
  aditionalsDivineMagics String
  Character              Character?
}

model Charisma {
  id                        String     @id @default(uuid())
  value                     Int
  maxFollowers              Int
  adjustmentReactionPercent Int
  livingDeadAway            String
  Character                 Character?
}

model Attack {
  id          String    @id @default(uuid())
  characterId String
  EquipmentId String
  Equipment   Equipment @relation(fields: [EquipmentId], references: [id], onDelete: Cascade)
  Character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Grimoire {
  id          String    @id @default(uuid())
  characterId String
  MagicId     String
  use         Int
  Magic       Magic     @relation(fields: [MagicId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Inventory {
  id          String    @id @default(uuid())
  characterId String    @unique
  EquipmentId String
  Equipment   Equipment @relation(fields: [EquipmentId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Equipment {
  id            String        @id @default(uuid())
  name          String
  quantity      Int
  charge        Int
  price         Int
  coin          Coin
  type          EquipmentType
  isMagic       Boolean
  size          Size
  weaponType    WeaponType?
  damageType    DamageType?
  damage        String?
  damageBonus   Int?
  armorBonus    Int?
  attackBonusC  Int?
  attackBonusD  Int?
  range         Int?
  increasesLoad Int?
  description   String        @db.VarChar(1000)
  Inventory     Inventory[]
  Attack        Attack[]
}

model Magic {
  id          String     @id @default(uuid())
  name        String
  type        MagicType
  circle      Int
  range       String
  duration    String
  savingThrow String
  description String     @db.VarChar(1000)
  Grimoire    Grimoire[]
}

enum Coin {
  COPPER
  SILVER
  GOLD
}

enum WeaponType {
  MELEE
  DISTANCE
}

enum DamageType {
  IMPACTFUL
  PIERCING
  CUTTING
}

enum EquipmentType {
  ARMOR
  WEAPON
  SHIELD
  GENERAL
  CONTAINERS
  MOUNTING
}

enum Sytem {
  OLDRAGON
  CUSTOM
}

enum Race {
  HUMAN
  DWARF
  ELF
  HALFELF
  HALFLING
  GNOME
}

enum Class {
  ROGUE
  WIZARD
  CLERIC
  FIGHTER
}

enum SUBCLASS {
  BARBARIAN
  PALADIN
  DWARFADVENTURER
  ARCHER
  DRUID
  ACADEMIC
  SHAMAN
  OUTLAWED
  RANGER
  BARD
  KILLER
  HALFLINGADVENTURER
  ILLUSIONIST
  NECROMANTE
  WITCHER
  ELFADVENTURER
}

enum Alignment {
  ORDERLY
  NEUTRAL
  CHAOTIC
}

enum MagicType {
  ARCANE
  DIVINE
}

enum Size {
  SM
  MD
  LG
}
